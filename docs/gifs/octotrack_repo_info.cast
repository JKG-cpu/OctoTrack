[0.062, "o", "\r\u001b[2K\u001b[1;34m╭───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m                                                                                                                                                   \u001b[0m\u001b[1;34m│\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;36mJKG-cpu/OctoTrack\u001b[0m\u001b[1;37m                                                                                                                              \u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;34m│\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;35m PUBLIC \u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;33mPython\u001b[0m\u001b[1;37m  ·  \u001b[0m\u001b[1;2;3;37mMIT License\u001b[0m\u001b[1;37m  ·  \u001b[0m\u001b[1;2;3;37mREADME.md\u001b[0m\u001b[1;37m                                                                                                 \u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;34m│\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;37m                                                                                                                                               \u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;34m│\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;39mAn Async API CLI Client for GitHub that can be used to track things like GitHub releases\u001b[0m\u001b[1;37m                                                       \u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;34m│\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;37m                                                                                                                                               \u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;34m│\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;33m★ \u001b[0m\u001b[1;37m1 \u001b[0m\u001b[1;2;37mstars\u001b[0m\u001b[1;37m   \u001b[0m\u001b[1;33m⑂ \u001b[0m\u001b[1;37m0 \u001b[0m\u001b[1;2;37mforks\u001b[0m\u001b[1;37m   \u001b[0m\u001b[1;33m◎ \u001b[0m\u001b[1;37m1 \u001b[0m\u001b[1;2;37mwatchers\u001b[0m\u001b[1;37m   \u001b[0m\u001b[1;33m▣ \u001b[0m\u001b[1;37m207 B \u001b[0m\u001b[1;2;37msize\u001b[0m\u001b[1;37m                                                                                            \u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;34m│\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;2;3;37m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;34m│\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;2;37m         Owner\u001b[0m\u001b[1;2;37m  \u001b[0m\u001b[1;39mJKG-cpu (User)                                                     \u001b[0m\u001b[1;37m                                                            \u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;34m│\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;2;37m           URL\u001b[0m\u001b[1;2;37m  \u001b[0m\u001b[1;39mhttps://github.com/JKG-cpu/OctoTrack                               \u001b[0m\u001b[1;37m                                                            \u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;34m│\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;2;37mDefault branch\u001b[0m\u001b[1;2;37m  \u001b[0m\u001b[1;39mmain                                                               \u001b[0m\u001b[1;37m                                                            \u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;34m│\u001b[0m\r\n\u001b[1;34m│\u001b[0m\u001b[1;37m  \u001b[0m\u001b[1;2;37m      Homepage\u001b[0m\u001b[1;2;37m  \u001b[0m\u001b[1;39m—                                                                  \u001b[0m\u001b[1;37m                                                            \u001b[0m\u00